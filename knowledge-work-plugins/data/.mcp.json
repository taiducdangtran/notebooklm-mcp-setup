{
  "mcpServers": {
    "snowflake": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-snowflake"],
      "env": {
        "SNOWFLAKE_ACCOUNT": "${SNOWFLAKE_ACCOUNT}",
        "SNOWFLAKE_USER": "${SNOWFLAKE_USER}",
        "SNOWFLAKE_PASSWORD": "${SNOWFLAKE_PASSWORD}",
        "SNOWFLAKE_DATABASE": "${SNOWFLAKE_DATABASE}",
        "SNOWFLAKE_WAREHOUSE": "${SNOWFLAKE_WAREHOUSE}"
      }
    },
    "databricks": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-databricks"],
      "env": {
        "DATABRICKS_HOST": "${DATABRICKS_HOST}",
        "DATABRICKS_TOKEN": "${DATABRICKS_TOKEN}"
      }
    },
    "bigquery": {
      "type": "http",
      "url": "https://bigquery.googleapis.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GOOGLE_ACCESS_TOKEN}"
      }
    },
    "hex": {
      "type": "http",
      "url": "https://app.hex.tech/mcp",
      "headers": {
        "Authorization": "Bearer ${HEX_API_KEY}"
      }
    },
    "amplitude": {
      "type": "http",
      "url": "https://mcp.amplitude.com/mcp",
      "headers": {
        "Authorization": "Bearer ${AMPLITUDE_API_KEY}"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${ATLASSIAN_TOKEN}"
      }
    },
    "definite": {
      "type": "http",
      "url": "https://api.definite.app/v3/mcp/http",
      "headers": {
        "Authorization": "Bearer ${DEFINITE_API_KEY}"
      }
    }
  }
}
