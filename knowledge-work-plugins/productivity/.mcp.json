{
  "mcpServers": {
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-notion"],
      "env": {
        "NOTION_API_TOKEN": "${NOTION_API_TOKEN}"
      }
    },
    "asana": {
      "type": "http",
      "url": "https://mcp.asana.com/mcp",
      "headers": {
        "Authorization": "Bearer ${ASANA_TOKEN}"
      }
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${ATLASSIAN_TOKEN}"
      }
    },
    "microsoft365": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-microsoft365"],
      "env": {
        "MS365_CLIENT_ID": "${MS365_CLIENT_ID}",
        "MS365_CLIENT_SECRET": "${MS365_CLIENT_SECRET}",
        "MS365_TENANT_ID": "${MS365_TENANT_ID}"
      }
    },
    "monday": {
      "type": "http",
      "url": "https://mcp.monday.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MONDAY_API_KEY}"
      }
    },
    "clickup": {
      "type": "http",
      "url": "https://mcp.clickup.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLICKUP_API_KEY}"
      }
    }
  }
}
